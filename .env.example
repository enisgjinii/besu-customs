# Server-only OpenAI image generation.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1

# Supabase Storage for generated artwork. The service role key must stay server-only.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DESIGNER_ASSETS_BUCKET=designer-assets

# Explicit local/demo mode only. Production should leave this false or unset.
DESIGNER_MOCK_AI=false

# Optional: force local disk asset storage on a writable machine (dev only).
# Ignored automatically on Vercel/Lambda — production must use Supabase below.
# DESIGNER_LOCAL_ASSETS=true

# Public Shopify storefront origin allowed to receive the checkout message.
# Example format only: https://your-store.myshopify.com
NEXT_PUBLIC_SHOPIFY_PARENT_ORIGIN=

# Optional app telemetry.
NEXT_PUBLIC_ENABLE_VERCEL_ANALYTICS=false
