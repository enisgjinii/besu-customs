# =============================================================================
# BESU Customs — environment variables
# Copy to .env.local for local dev. Set Production + Preview in Vercel dashboard
# (or `vercel env add`). Never commit real secrets.
# =============================================================================

# --- Required on Vercel (AI Uniform Designer) --------------------------------

# Server-only OpenAI image generation
OPENAI_API_KEY=

# Supabase: auth + generated artwork storage (service role stays server-only)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DESIGNER_ASSETS_BUCKET=designer-assets

# Shopify iframe checkout handoff (your storefront origin)
NEXT_PUBLIC_SHOPIFY_PARENT_ORIGIN=

# --- Optional (AI designer) ----------------------------------------------------

OPENAI_IMAGE_MODEL=gpt-image-1
NEXT_PUBLIC_ENABLE_VERCEL_ANALYTICS=false

# --- Local development only (ignored on Vercel) --------------------------------

# Deterministic preview renderer — never enable in Production/Preview on Vercel
# DESIGNER_MOCK_AI=true

# Local disk asset storage — dev laptops only; Vercel always uses Supabase
# DESIGNER_LOCAL_ASSETS=true

# =============================================================================
# Legacy routes (/texture-generator, /admin/ai-generator, send-design email)
# Remove from Vercel if you are not using these pages.
# =============================================================================

# GEMINI_API_KEY=
# GEMINI_UPSTREAM_TIMEOUT_MS=290000
# NEXT_PUBLIC_GOOGLE_API_KEY=
# MESHY_API_KEY=
# RUNWARE_AI=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
