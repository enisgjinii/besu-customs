# =============================================================================
# BESU Customs — environment variables
# Copy to .env.local for local dev. Set Production + Preview in Vercel dashboard.
# =============================================================================

# --- Required on Vercel (AI Uniform Designer) --------------------------------

# Server-only OpenAI image generation
OPENAI_API_KEY=

# Vercel Blob stores generated uniform PNGs. Auto-injected when a Blob store is
# linked to the project in Vercel → Storage → Blob. For local dev, either link
# the store and run `vercel env pull`, or set DESIGNER_LOCAL_ASSETS=true below.
# BLOB_READ_WRITE_TOKEN=

# Shopify iframe checkout handoff (your storefront origin)
NEXT_PUBLIC_SHOPIFY_PARENT_ORIGIN=

# --- Optional (AI designer) ----------------------------------------------------

OPENAI_IMAGE_MODEL=gpt-image-1
NEXT_PUBLIC_ENABLE_VERCEL_ANALYTICS=false

# --- Local development only (ignored on Vercel) --------------------------------

# Deterministic preview renderer — never enable in Production/Preview on Vercel
# DESIGNER_MOCK_AI=true

# Local disk asset storage — dev laptops only; Vercel uses Blob instead
# DESIGNER_LOCAL_ASSETS=true

# =============================================================================
# Legacy admin / 3D routes still reference Supabase auth if those pages are used.
# The public AI designer no longer requires Supabase.
# =============================================================================

# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Legacy routes (/texture-generator, send-design email, etc.)
# GEMINI_API_KEY=
# MESHY_API_KEY=
# RUNWARE_AI=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
