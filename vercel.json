{
  "regions": ["iad1"],
  "functions": {
    "app/api/gemini/**/*.ts": {
      "maxDuration": 300
    },
    "app/api/designer/generate/route.ts": {
      "maxDuration": 120
    },
    "app/api/designer/logo/route.ts": {
      "maxDuration": 60
    },
    "app/api/**/*.ts": {
      "maxDuration": 10,
      "excludeFiles": "{public/**,node_modules/@babylonjs/**,node_modules/@imgly/**,node_modules/onnxruntime-web/**,node_modules/sharp/**}"
    }
  },
  "outputDirectory": ".next",
  "cleanUrls": true,
  "rewrites": [],
  "headers": [
    {
      "source": "/models/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
